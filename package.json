{
  "name": "bossa-store",
  "version": "1.0.0",
  "description": "",
  "scripts": {
    "dev": "concurrently -k -n api,web \"npm:dev:api\" \"npm:dev:web\"",
    "dev:web": "vite --host 127.0.0.1",
    "dev:api": "node --watch --import tsx server/index.ts",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "start": "tsx server/index.ts",
    "typecheck": "vue-tsc --noEmit",
    "lint": "eslint src shared server api scripts tests .storybook --ext .ts,.vue --no-error-on-unmatched-pattern",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "storybook": "storybook dev -p 6006 --no-open --disable-telemetry",
    "build-storybook": "storybook build --disable-telemetry",
    "scrape": "tsx scripts/scraping/collect.ts",
    "check": "npm run lint && npm run typecheck && npm test && npm run build && npm run build-storybook",
    "build:deploy": "npm run build && npm run build-storybook && node scripts/package-storybook.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Fcb-dev/Front-end-Challenge---UmaPenca.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "bugs": {
    "url": "https://github.com/Fcb-dev/Front-end-Challenge---UmaPenca/issues"
  },
  "homepage": "https://github.com/Fcb-dev/Front-end-Challenge---UmaPenca#readme",
  "dependencies": {
    "@fontsource/inter": "5.2.6",
    "@fontsource/nunito": "5.2.6",
    "express": "5.1.0",
    "vue": "2.7.16",
    "vue-router": "3.6.5"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@storybook/addon-essentials": "7.6.24",
    "@storybook/vue-vite": "7.6.24",
    "@types/express": "5.0.3",
    "@types/node": "22.15.3",
    "@typescript-eslint/eslint-plugin": "8.31.0",
    "@typescript-eslint/parser": "8.31.0",
    "@vitejs/plugin-vue2": "2.3.3",
    "@vue/test-utils": "1.3.6",
    "autoprefixer": "10.4.21",
    "cheerio": "1.0.0-rc.12",
    "concurrently": "9.1.2",
    "eslint": "8.57.1",
    "eslint-plugin-vue": "9.32.0",
    "jsdom": "24.1.3",
    "postcss": "8.5.29",
    "prettier": "3.5.3",
    "storybook": "7.6.24",
    "tailwindcss": "3.4.17",
    "tsx": "4.20.6",
    "typescript": "5.3.3",
    "vite": "5.4.21",
    "vitest": "3.2.6",
    "vue-template-compiler": "2.7.16",
    "vue-tsc": "1.8.27"
  },
  "private": true,
  "engines": {
    "node": ">=22 <25"
  }
